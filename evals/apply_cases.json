  {
    "id": "tracking-low-blocks-budget-write",
    "type": "budget_guardrail",
    "input": {
      "tracking_confidence": "low",
      "pending_tracking_drafts": false,
      "actions": [
        {
          "current_micros": 50000000,
          "proposed_micros": 45000000,
